JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite+aiosqlite:///./sail_academy.db
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Optional local model; nothing is downloaded automatically.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_ENABLED=true
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.73
RAG_INDEX_PATH=./rag_index.sqlite3
OLLAMA_TIMEOUT_SECONDS=35
